<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Expense_Tracker.App</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
    <PackageReference Include="ErrorOr" Version="2.0.1" />

    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />

    <PackageReference Include="Hangfire" Version="1.8.23" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
    <PackageReference Include="Hangfire.Dashboard.Basic.Authentication" Version="8.0.0" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />

    <PackageReference Include="Mapster" Version="10.0.7" />
    <PackageReference Include="Mapster.DependencyInjection" Version="10.0.7" />

    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.7" />

    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
    <PackageReference Include="Resend" Version="0.5.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.9" />
    <PackageReference Include="Scrutor" Version="7.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    <PackageReference Include="WolverineFx" Version="5.36.2" />
    <PackageReference Include="WolverineFx.Http" Version="5.36.2" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="5.36.2" />
    <PackageReference Include="WolverineFx.Postgresql" Version="5.36.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Expense_Tracker.Application\Expense_Tracker.Application.csproj" />
    <ProjectReference Include="..\Expense_Tracker.Contracts\Expense_Tracker.Contracts.csproj" />
    <ProjectReference Include="..\Expense_Tracker.Domain\Expense_Tracker.Domain.csproj" />
    <ProjectReference Include="..\Expense_Tracker.Infrastructure\Expense_Tracker.Infrastructure.csproj" />
  </ItemGroup>

</Project>
